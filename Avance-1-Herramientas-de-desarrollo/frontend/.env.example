# Desarrollo local: ya viene configurado en .env.development (no necesitas copiar nada).
#
# Producción (build para S3): crea frontend/.env.production con la URL pública del backend en la EC2:
#   VITE_API_URL=http://TU_IP_ELASTICA/api
# "npm run build" falla si esta variable no está definida.
VITE_API_URL=http://localhost:8080/api
