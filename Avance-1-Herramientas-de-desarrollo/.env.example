# Copia este archivo como .env en la EC2 (mismo directorio que compose.prod.yaml) y completa los valores.
# NUNCA subas el archivo .env a Git.

# --- PostgreSQL (contenedor interno, no expuesto a Internet) ---
DB_NAME=sabor_db
DB_USERNAME=sabor_user
# Genera una con: openssl rand -base64 24
DB_PASSWORD=CAMBIAR_password_postgres

# --- Seguridad del backend ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_secreto_jwt_de_al_menos_32_caracteres
JWT_EXPIRATION_HOURS=8
ADMIN_USERNAME=admin
# Mínimo 10 caracteres. Es la contraseña del panel /admin.
ADMIN_PASSWORD=CAMBIAR_password_admin

# --- CORS: URL exacta del sitio web del bucket S3 del frontend (sin "/" final) ---
CORS_ALLOWED_ORIGINS=http://NOMBRE-BUCKET-FRONTEND.s3-website-us-east-1.amazonaws.com

# --- Imágenes en S3 ---
# Bucket de imágenes. Déjalo vacío para desactivar la carga desde el panel
# (las URLs pegadas a mano siguen funcionando).
S3_BUCKET=NOMBRE-BUCKET-IMAGENES
AWS_REGION=us-east-1
# Opcional: base de las URLs públicas. Por defecto https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com
S3_PUBLIC_BASE_URL=

# --- Varios ---
# Puerto público de la API en la EC2.
API_PORT=80
JAVA_OPTS=-XX:MaxRAMPercentage=75
